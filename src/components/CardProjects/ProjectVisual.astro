---
// Illustrations, not screenshots: the two private apps hold real conversations.
// Each one loops a short CSS-only story once its [data-reveal] wrapper is visible.
import type { Card } from './dataCards'
import type { Lang } from '../../i18n/loader'
import { host } from './shared'

interface Props {
  card: Card
  lang: Lang
}
const { card, lang } = Astro.props
const es = lang === 'es'
const bar = card.website ? host(card.website) : card.id === 'messaging' ? card.project : es ? 'Panel de la clínica' : 'Clinic dashboard'

const lines = {
  rec: { name: es ? 'Reclutamiento' : 'Recruiting', color: 'var(--cobalt)' },
  sales: { name: es ? 'Ventas' : 'Sales', color: 'var(--carmine)' },
  support: { name: es ? 'Soporte' : 'Support', color: '#a87400' },
}
const chats = [
  { name: 'Ana Rojas', line: lines.rec, hue: 215 },
  { name: 'Luis Peña', line: lines.sales, hue: 282, incoming: true },
  { name: 'Carla Méndez', line: lines.support, hue: 349 },
  { name: 'Diego Soto', line: lines.rec, hue: 56 },
  { name: 'Marta Gil', line: lines.sales, hue: 123 },
]
const wave = [3, 6, 9, 5, 8, 4, 7, 9, 5, 3, 6, 8, 4, 6, 3]
---

<div class="frame" data-id={card.id} aria-hidden={card.id === 'resorsi' ? undefined : 'true'}>
  <div class="bar"><i></i><i></i><i></i><span>{bar}</span></div>

  {
    card.id === 'resorsi' && (
      <div class="shot">
        <picture>
          <source
            type="image/avif"
            srcset="/images/projects/resorsi-720.avif 720w, /images/projects/resorsi-1280.avif 1280w"
            sizes="(max-width: 820px) 100vw, 620px"
          />
          <img src={card.image} alt={card.alt} width="1280" height="800" loading="lazy" decoding="async" />
        </picture>
        <div class="form a3" aria-hidden="true">
          <span>{es ? 'Busco talento' : 'Looking for talent'}</span>
          <u><s /></u>
          <u><s style="width:70%" /></u>
          <div class="sent a5">
            <b />
            {es ? 'Lead creado en Zoho CRM' : 'Lead created in Zoho CRM'}
          </div>
        </div>
        <svg class="cur" viewBox="0 0 12 16" aria-hidden="true"><path d="M1 1v12l3.2-3 2.2 5 2-.9-2.2-4.9H11z" /></svg>
      </div>
    )
  }

  {
    card.id === 'messaging' && (
      <div class="msg">
        <div class="list">
          <div class="lines">
            <span>{es ? '3 líneas' : '3 lines'}</span>
            {Object.values(lines).map(l => <i style={`background:${l.color}`} />)}
          </div>
          {chats.map((c, i) => (
            <div class:list={['chat', { on: i === 0 }]}>
              <b style={`--h:${c.hue}`} />
              <div>
                <span>{c.name}</span>
                <small style={`color:${c.line.color}`}>{c.line.name}</small>
              </div>
              {c.incoming && <em class="a6" />}
            </div>
          ))}
        </div>
        <div class="thread">
          <header>
            <span>Ana Rojas</span>
            <b class="a2" style="--h:160" />
            <small style={`color:${lines.rec.color}`}>{lines.rec.name}</small>
          </header>
          <p class="in a1">{es ? 'Hola, sí puedo el jueves a las 10:00 a. m.' : 'Hi, yes, Thursday at 10:00 AM works.'}</p>
          <p class="out a3">{es ? 'Perfecto, Ana. Te envío el enlace de la entrevista.' : 'Great, Ana. Sending you the interview link.'}</p>
          <p class="in a4">{es ? '¡Gracias!' : 'Thank you!'}</p>
          <div class="compose"><span class="dots t1"><i /><i /><i /></span></div>
        </div>
        <div class="crm">
          <small>Zoho CRM</small>
          <span>Ana Rojas</span>
          <div class="stage">
            <mark class="was">{es ? 'Filtro' : 'Screening'}</mark>
            <mark class="a5">{es ? 'Entrevista' : 'Interview'}</mark>
          </div>
          <u style="width:90%" />
          <u style="width:64%" />
          <div class="note a5"><u style="width:85%" /><u style="width:55%" /></div>
        </div>
      </div>
    )
  }

  {
    card.id === 'bot' && (
      <div class="bot">
        <div class="phone">
          <div class="in voice a1">
            <i class="play" />
            <span class="wave">{wave.map(h => <i style={`height:${h * 0.28}cqw`} />)}</span>
            <small>0:07</small>
            <em class="a2">“¿Tienen cita para una limpieza esta semana?”</em>
          </div>
          <p class="out a3"><small>IA</small>¡Hola! Sí: jueves 10:30 a. m. o viernes 3:00 p. m.</p>
          <p class="in a4">El jueves, por favor.</p>
          <p class="out a5"><small>IA</small>Listo, te agendé el jueves a las 10:30 a. m.</p>
          <span class="dots t2"><i /><i /><i /></span>
        </div>
        <div class="side">
          <div class="panel">
            <small>{es ? 'Citas' : 'Appointments'}</small>
            <div class="row a5"><span>{es ? 'Jue 10:30 a. m.' : 'Thu 10:30 AM'}</span><mark>{es ? 'Agendada' : 'Booked'}</mark></div>
          </div>
          <div class="panel">
            <small>{es ? 'Relevo humano' : 'Human handoff'}</small>
            <div class="row"><b style="--h:200" /><span>Rosa M.</span><i>{es ? 'Humano' : 'Human'}</i></div>
            <div class="row a6"><b style="--h:350" /><span>Pedro L.</span><mark>{es ? 'Espera' : 'Waiting'}</mark></div>
          </div>
          <div class="panel">
            <small>{es ? 'Precios' : 'Pricing'}</small>
            <div class="row"><span>Limpieza</span><i>$35</i></div>
            <div class="row"><span>Consulta</span><i>$20</i></div>
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  .frame {
    --p: var(--paper);
    --k: var(--ink);
    --soft: rgba(var(--ink-rgb), 0.08);
    --d: 9s;
    container-type: inline-size;
    aspect-ratio: 16 / 10;
    width: 100%;
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: 10px;
    overflow: clip;
    background: var(--p);
    color: var(--k);
    text-align: left;
    line-height: 1.3;
    box-shadow: 0 0 0 1px var(--line);
  }
  /* cq units resolve against the frame only from its children down */
  .frame > * {
    font-size: 2.1cqw;
  }
  .frame * {
    box-sizing: border-box;
    margin: 0;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1cqw;
    padding: 1.4cqw 2cqw;
    background: #fff;
    border-bottom: 1px solid var(--soft);
  }
  .bar i {
    width: 1.5cqw;
    height: 1.5cqw;
    border-radius: 50%;
    background: rgba(var(--ink-rgb), 0.18);
  }
  .bar span {
    margin-left: 1.5cqw;
    font-size: 1.9cqw;
    color: rgba(var(--ink-rgb), 0.6);
  }
  u {
    display: block;
    height: 1.2cqw;
    border-radius: 99px;
    background: rgba(var(--ink-rgb), 0.13);
    text-decoration: none;
  }
  b {
    flex: none;
    width: 4.6cqw;
    height: 4.6cqw;
    border-radius: 50%;
    background: hsl(var(--h) 70% 62%);
  }
  small {
    font-size: 1.7cqw;
    font-weight: 600;
    color: rgba(var(--ink-rgb), 0.55);
  }
  mark {
    justify-self: start;
    padding: 0.4cqw 1.4cqw;
    border-radius: 99px;
    font-size: 1.7cqw;
    font-weight: 600;
    color: var(--k);
    background: var(--marigold);
  }
  .in,
  .out {
    max-width: 84%;
    padding: 1.3cqw 1.8cqw;
    border-radius: 2cqw;
    font-size: 2.2cqw;
    font-weight: 500;
  }
  .in {
    align-self: flex-start;
    background: #fff;
    border-bottom-left-radius: 0.4cqw;
  }
  .out {
    align-self: flex-end;
    color: #fff;
    background: var(--c, var(--cobalt));
    border-bottom-right-radius: 0.4cqw;
  }
  .dots {
    display: inline-flex;
    gap: 0.7cqw;
    opacity: 0;
  }
  .dots i {
    width: 1.1cqw;
    height: 1.1cqw;
    border-radius: 50%;
    background: rgba(var(--ink-rgb), 0.45);
  }

  /* resorsi.com: a visitor sends the form, the lead lands in the CRM */
  .shot {
    position: relative;
    min-height: 0;
    overflow: clip;
  }
  .shot picture {
    display: contents;
  }
  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  .form {
    position: absolute;
    right: 5cqw;
    top: 9cqw;
    width: 36cqw;
    display: grid;
    gap: 1.5cqw;
    padding: 2.4cqw;
    border-radius: 1.8cqw;
    background: #fff;
    box-shadow: 0 2cqw 5cqw rgba(var(--ink-rgb), 0.28);
  }
  .form span {
    font-weight: 700;
  }
  .form u {
    height: 3.4cqw;
    border-radius: 0.9cqw;
    background: var(--soft);
    padding: 1.1cqw;
  }
  .form s {
    display: block;
    width: 55%;
    height: 100%;
    border-radius: 99px;
    background: rgba(var(--ink-rgb), 0.35);
    transform-origin: left;
  }
  .sent {
    display: flex;
    align-items: center;
    gap: 1.2cqw;
    padding: 1.2cqw 1.4cqw;
    border-radius: 0.9cqw;
    font-size: 1.9cqw;
    font-weight: 600;
    background: rgba(var(--marigold-rgb), 0.3);
  }
  .sent b {
    width: 2cqw;
    height: 2cqw;
    background: #1f9d61;
  }
  .cur {
    position: absolute;
    left: 0;
    top: 0;
    width: 2.6cqw;
    opacity: 0;
    fill: var(--k);
    stroke: #fff;
    stroke-width: 1;
  }

  /* messaging: several lines, one inbox, the CRM beside the chat */
  .msg {
    display: grid;
    grid-template-columns: 27% 1fr 25%;
    min-height: 0;
  }
  .list {
    background: #fff;
    border-right: 1px solid var(--soft);
    padding: 1cqw;
    display: grid;
    align-content: start;
    gap: 0.3cqw;
  }
  .lines {
    display: flex;
    align-items: center;
    gap: 0.7cqw;
    padding: 0.8cqw 1.2cqw 1.2cqw;
    font-size: 1.7cqw;
    font-weight: 700;
  }
  .lines span {
    margin-right: auto;
  }
  .lines i {
    width: 1.5cqw;
    height: 1.5cqw;
    border-radius: 50%;
  }
  .chat {
    display: flex;
    align-items: center;
    gap: 1.3cqw;
    padding: 1cqw 1.2cqw;
    border-radius: 1.4cqw;
  }
  .chat.on {
    background: var(--soft);
  }
  .chat div {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 0.2cqw;
  }
  .chat span,
  .crm span,
  .thread header span {
    font-weight: 600;
    white-space: nowrap;
  }
  .chat em {
    width: 1.6cqw;
    height: 1.6cqw;
    border-radius: 50%;
    background: var(--carmine);
  }
  .thread {
    display: flex;
    flex-direction: column;
    gap: 1.4cqw;
    padding: 0 2cqw 1.6cqw;
    min-width: 0;
  }
  .thread header {
    display: flex;
    align-items: center;
    gap: 1cqw;
    padding: 1.4cqw 0;
    border-bottom: 1px solid var(--soft);
  }
  .thread header b {
    width: 2.8cqw;
    height: 2.8cqw;
    box-shadow: 0 0 0 0.4cqw var(--p);
  }
  .thread header small {
    margin-left: auto;
  }
  .compose {
    margin-top: auto;
    min-height: 4.4cqw;
    display: flex;
    align-items: center;
    padding: 0 1.8cqw;
    border-radius: 99px;
    background: #fff;
  }
  .crm {
    background: #fff;
    border-left: 1px solid var(--soft);
    padding: 1.8cqw;
    display: grid;
    align-content: start;
    gap: 1.3cqw;
  }
  .stage {
    display: grid;
    justify-items: start;
  }
  .stage mark {
    grid-area: 1 / 1;
  }
  .was {
    opacity: 0;
    background: var(--soft);
  }
  .note {
    margin-top: 1cqw;
    padding: 1.4cqw;
    border-radius: 1.2cqw;
    background: rgba(var(--marigold-rgb), 0.25);
    display: grid;
    gap: 0.9cqw;
  }

  /* clinic bot: voice note in, booking out, a person takes over when needed */
  .bot {
    --d: 10s;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    min-height: 0;
  }
  .phone {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.3cqw;
    padding: 2cqw 2cqw 4cqw;
    border-right: 1px solid var(--soft);
  }
  .phone .dots {
    position: absolute;
    right: 2.4cqw;
    bottom: 1.8cqw;
  }
  .voice {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9cqw 1.2cqw;
  }
  .play {
    border-left: 1.8cqw solid var(--c, var(--carmine));
    border-block: 1.1cqw solid transparent;
  }
  .wave {
    display: flex;
    align-items: center;
    gap: 0.5cqw;
  }
  .wave i {
    width: 0.5cqw;
    border-radius: 99px;
    background: rgba(var(--ink-rgb), 0.4);
  }
  .voice em {
    grid-column: 1 / -1;
    font-size: 1.8cqw;
    color: rgba(var(--ink-rgb), 0.7);
  }
  .out small {
    display: inline-block;
    margin-right: 1cqw;
    padding: 0 0.9cqw;
    border-radius: 0.8cqw;
    font-size: 1.5cqw;
    color: var(--c, var(--carmine));
    background: #fff;
    vertical-align: 0.15cqw;
  }
  .side {
    display: grid;
    align-content: center;
    gap: 1.4cqw;
    padding: 2cqw;
  }
  .panel {
    display: grid;
    gap: 1cqw;
    padding: 1.5cqw;
    border-radius: 1.6cqw;
    background: #fff;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 1.2cqw;
    min-height: 3.4cqw;
    font-weight: 500;
  }
  .row b {
    width: 3.2cqw;
    height: 3.2cqw;
  }
  .row mark,
  .row i {
    margin-left: auto;
    font-style: normal;
    font-weight: 600;
  }
  .row i {
    font-size: 1.8cqw;
  }

  /* The story: steps a1..a6 appear within the first half, then the finished scene holds before the loop restarts.
     Without motion (or before the reveal) every step is simply shown: the finished scene. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.is-visible) .frame :is(.a1, .a2, .a3, .a4, .a5, .a6, .t1, .t2, .was, .cur, .form s) {
      /* longhands: a shorthand here would outrank the per-step names below and reset them */
      animation-duration: var(--d);
      animation-iteration-count: infinite;
      animation-fill-mode: both;
    }
    :global(.is-visible) .frame .a1 { animation-name: pv-1; }
    :global(.is-visible) .frame .a2 { animation-name: pv-2; }
    :global(.is-visible) .frame .a3 { animation-name: pv-3; }
    :global(.is-visible) .frame .a4 { animation-name: pv-4; }
    :global(.is-visible) .frame .a5 { animation-name: pv-5; }
    :global(.is-visible) .frame .a6 { animation-name: pv-6; }
    :global(.is-visible) .frame .t1 { animation-name: pv-typing-1; }
    :global(.is-visible) .frame .t2 { animation-name: pv-typing-2; }
    :global(.is-visible) .frame .was { animation-name: pv-was; }
    :global(.is-visible) .frame .cur { animation-name: pv-cursor; }
    :global(.is-visible) .frame .form s { animation-name: pv-fill; }
    :global(.is-visible) .frame .dots i { animation: 0.9s infinite pv-dot; }
    :global(.is-visible) .frame .dots i:nth-child(2) { animation-delay: 0.15s; }
    :global(.is-visible) .frame .dots i:nth-child(3) { animation-delay: 0.3s; }
  }
  @keyframes pv-1 {
    0%, 2% { opacity: 0; transform: translateY(1.4cqw); }
    5%, 94% { opacity: 1; transform: none; }
    100% { opacity: 0; }
  }
  @keyframes pv-2 {
    0%, 10% { opacity: 0; transform: translateY(1.4cqw); }
    13%, 94% { opacity: 1; transform: none; }
    100% { opacity: 0; }
  }
  @keyframes pv-3 {
    0%, 21% { opacity: 0; transform: translateY(1.4cqw); }
    24%, 94% { opacity: 1; transform: none; }
    100% { opacity: 0; }
  }
  @keyframes pv-4 {
    0%, 29% { opacity: 0; transform: translateY(1.4cqw); }
    32%, 94% { opacity: 1; transform: none; }
    100% { opacity: 0; }
  }
  @keyframes pv-5 {
    0%, 39% { opacity: 0; transform: translateY(1.4cqw); }
    42%, 94% { opacity: 1; transform: none; }
    100% { opacity: 0; }
  }
  @keyframes pv-6 {
    0%, 48% { opacity: 0; transform: scale(0.6); }
    51%, 94% { opacity: 1; transform: none; }
    100% { opacity: 0; }
  }
  @keyframes pv-typing-1 {
    0%, 12%, 22%, 100% { opacity: 0; }
    14%, 20% { opacity: 1; }
  }
  @keyframes pv-typing-2 {
    0%, 12%, 22%, 31%, 40%, 100% { opacity: 0; }
    14%, 20%, 33%, 38% { opacity: 1; }
  }
  @keyframes pv-was {
    0%, 39% { opacity: 1; }
    42%, 100% { opacity: 0; }
  }
  @keyframes pv-fill {
    0%, 26% { transform: scaleX(0); }
    37%, 94% { transform: scaleX(1); }
    100% { transform: scaleX(0); }
  }
  @keyframes pv-cursor {
    0%, 2% { opacity: 0; transform: translate(40cqw, 52cqw); }
    5% { opacity: 1; transform: translate(40cqw, 52cqw); }
    15%, 17% { transform: translate(13cqw, 40.5cqw); }
    18.5% { transform: translate(13cqw, 40.5cqw) scale(0.8); }
    20%, 22% { transform: translate(13cqw, 40.5cqw); }
    30%, 94% { opacity: 1; transform: translate(74cqw, 30cqw); }
    100% { opacity: 0; transform: translate(74cqw, 30cqw); }
  }
  @keyframes pv-dot {
    0%, 60%, 100% { transform: none; }
    30% { transform: translateY(-0.6cqw); }
  }
</style>
