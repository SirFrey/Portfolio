---
import dataCards from './dataCards'
import type { Lang } from '../../i18n/loader'
import ProjectVisual from './ProjectVisual.astro'
import ProjectLink from './ProjectLink.astro'
import { accent } from './shared'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
---

<div class="rows">
  {
    dataCards.map(card => (
      <article class="row" style={`--c:${accent[card.id]}`}>
        <div class="vis" data-reveal="bottom">
          <ProjectVisual card={card} lang={lang} />
        </div>
        <div class="txt">
          <header>
            <h3>{card.project}</h3>
            <span>{card.date}</span>
          </header>
          <p class="kind">{card.kind[lang]}</p>
          <p class="desc" set:html={card.description[lang]} />
          <ul>
            {card.points[lang].map(p => (
              <li>{p}</li>
            ))}
          </ul>
          <p class="stack">{card.stack.join(', ')}</p>
          <ProjectLink card={card} lang={lang} />
        </div>
      </article>
    ))
  }
</div>

<style>
  .rows {
    width: 100%;
    display: grid;
    gap: clamp(3.5rem, 8vw, 6.5rem);
    margin-top: 1.5rem;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  /* the picture keeps the wide column when it moves to the right */
  .row:nth-child(even) {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }
  .row:nth-child(even) .vis {
    order: 2;
  }
  .vis {
    position: relative;
  }
  /* the project's stripe colour, offset behind the frame */
  .vis::before {
    content: '';
    position: absolute;
    inset: 14px -14px -14px 14px;
    border-radius: 10px;
    background: var(--c);
    opacity: 0.9;
  }
  .row:nth-child(even) .vis::before {
    inset: 14px 14px -14px -14px;
  }
  .vis > :global(*) {
    position: relative;
  }
  .txt {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }
  header {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }
  h3 {
    font-family: var(--display);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--paper);
  }
  header span {
    font-size: 0.85rem;
    color: var(--mist);
  }
  .kind {
    margin: -0.4rem 0 0;
    font-size: 1rem;
    line-height: 1.4;
    font-weight: 600;
    color: var(--c);
  }
  .desc {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--mist);
    text-wrap: pretty;
  }
  ul {
    margin: 0;
    display: grid;
    gap: 0.45rem;
  }
  li {
    position: relative;
    padding-left: 1.2rem;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--paper);
  }
  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.25em;
    width: 2px;
    height: 0.95em;
    background: var(--c);
  }
  .stack {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--mist);
  }
  @media (max-width: 820px) {
    .row,
    .row:nth-child(even) {
      grid-template-columns: minmax(0, 1fr);
    }
    .row:nth-child(even) .vis {
      order: 0;
    }
    .vis::before,
    .row:nth-child(even) .vis::before {
      inset: 8px -6px -8px 8px;
    }
  }
</style>
