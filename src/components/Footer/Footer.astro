---
import ContactForm from './ContactForm'
import type { Dictionary } from '../../i18n/loader'
import { links } from './dataFooter'
import s from './Footer.module.css'
// NOTE: FontAwesome SVG icons are inlined statically; their raw SVG is generated
// via `icon()` from the core package so we don't need the React wrapper here.
import { icon, type IconDefinition } from '@fortawesome/fontawesome-svg-core'

interface Props {
  dict: Dictionary
}

const { dict } = Astro.props

const socialIcons = links.map(link => ({
  ...link,
  svg: icon(link.iconFontAwesome as IconDefinition).html.join(''),
}))
---

<footer id="contacto" class={s.footer_final}>
  <div class={s.contactGrid} data-reveal>
    <div class={s.contactIntro}>
      <h2>{dict.footer.title}</h2>
      <p class={s.contactSub}>{dict.footer.subtitle}</p>

      <div class={s.contactLinks}>
        <span class={s.contactLinksLabel}>{dict.footer.findme}</span>
        <ul class={s.contactList}>
          {
            socialIcons.map(({ href, title, svg }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-cursor="open"
                  class={s.contactLink}>
                  <span class={s.clIc} set:html={svg} />
                  {title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <ContactForm dict={dict} client:load />
  </div>
</footer>
