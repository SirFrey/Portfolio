---
import SDownComp from '@components/ScrolllDownComp/SDownComp.astro'
import SceneSection from '@components/Canvas/SceneSection'
import Hero from '@components/Hero/Hero'
import type { Dictionary } from '../../i18n/loader'

interface Props {
  dict: Dictionary
}

const { dict } = Astro.props
---

<section id="inicio">
  <SceneSection client:only="react" />
  <Hero
    title={dict.mainsection.titleh1}
    roles={dict.mainsection.roles}
    ctaProjects={dict.cta.projects}
    ctaContact={dict.cta.contact}
    client:load
  />
  <div class="hero-fade"></div>
  <SDownComp />
</section>

<style>
  /* clean gradient fade into the next (lighter teal) section — replaces the old SVG wave */
  .hero-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 26vh;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(var(--secondary), 0) 0%,
      rgba(var(--secondary), 0.55) 60%,
      var(--secondaryColor) 100%
    );
    pointer-events: none;
  }
</style>
