---
import type { Lang, Dictionary } from '../../i18n/loader'
import MainSection from './MainSection.astro'
import ProjectCards from '@components/CardProjects/ProjectCards.astro'
import { ListContainer } from '@components/ListContainers/ListContainer'
import { ListContainerDev } from '@components/ListContainers/ListContainerDev'
import Divider from '@components/Divider/Divider.astro'
import Shape3D from '@components/Divider/Shape3D'
import s from './Articles.module.css'

interface Props {
  dict: Dictionary
  lang: Lang
}

const { dict, lang } = Astro.props
---

<article class={s.articlePage}>
  <MainSection dict={dict} />

  <section>
    <div id="portfolio" class="marginContainer">
      <h2 data-reveal>{dict.portfolioSection.titleh2}</h2>
      <ProjectCards lang={lang} dict={dict} />
    </div>
    <Divider top="var(--secondaryColor)" bottom="var(--principalColor)">
      <Shape3D logo="react" side="right" client:only="react" />
    </Divider>
  </section>

  <section>
    <div id="conocimientos" class={`marginContainer ${s.knowledgeContainer}`}>
      <div data-reveal>
        <h2>{dict.knowledgesSection.titleh2}</h2>
        <h3>{dict.knowledgesSection.subtitleh3}</h3>
      </div>
      <ListContainer dict={dict} lang={lang} client:visible />
    </div>
  </section>

  <section>
    <Divider top="var(--principalColor)" bottom="var(--secondaryColor)">
      <Shape3D logo="typescript" side="left" client:only="react" />
    </Divider>
    <div id="aboutme" class="marginContainer">
      <h2>{dict.aboutmeSection.titleh2}</h2>
      <div class={s.paragraphWrapper}>
        <p class="p" data-reveal set:html={dict.aboutmeSection.p1}></p>
        <p class="p" data-reveal set:html={dict.aboutmeSection.p2}></p>
      </div>
    </div>
    <Divider top="var(--secondaryColor)" bottom="var(--principalColor)">
      <Shape3D logo="astro" side="right" client:only="react" />
    </Divider>
  </section>

  <section>
    <div class={`marginContainer ${s.developingContainer}`}>
      <h2 data-reveal>{dict.developingSection.titleh2}</h2>
      <ListContainerDev lang={lang} client:visible />
    </div>
  </section>

  <Divider top="var(--principalColor)" bottom="var(--principalColorDark)">
    <Shape3D logo="threejs" side="left" client:only="react" />
  </Divider>
</article>
