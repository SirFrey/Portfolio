---
// Professional section divider: a thin luminous seam (near-white core wrapped in a
// cyan glow halo) sitting on the color handoff between two sections. Replaces the
// old layered SVG waves. Static — needs no client JS.
// The optional default slot is for a seam object (e.g. the Shape3D R3F island),
// rendered outside the clipped band so it can float across the seam.
interface Props {
  /** CSS color of the section above the seam. */
  top: string
  /** CSS color of the section below the seam. */
  bottom: string
  /** Height of the gradient band in px. */
  height?: number
}

const { top, bottom, height = 96 } = Astro.props
---

<div class="divider-wrap">
  <div
    class="divider"
    style={`height:${height}px;background:linear-gradient(${top} 0 50%, ${bottom} 50% 100%)`}>
    <div class="d-halo"></div>
    <div class="d-core"></div>
  </div>
  <slot />
</div>

<style>
  .divider-wrap {
    position: relative;
  }
  .divider {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .d-halo,
  .d-core {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-radius: 999px;
  }
  .d-halo {
    width: min(62%, 780px);
    height: 4px;
    filter: blur(4px);
    opacity: 0.9;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(var(--glow-rgb), 0.95) 50%,
      transparent
    );
  }
  .d-core {
    width: min(60%, 760px);
    height: 1.5px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(232, 250, 255, 0.97) 50%,
      transparent
    );
    box-shadow: 0 0 6px rgba(255, 255, 255, 0.55);
  }
</style>
