---
// Section divider: the .chroma-stripes band on the handoff between two sections.
// Static — needs no client JS.
// The optional default slot is for a seam object (e.g. the Shape3D R3F island),
// rendered outside the clipped band so it can float across the seam.
interface Props {
  /** CSS color of the section above the seam. */
  top: string
  /** CSS color of the section below the seam. */
  bottom: string
  /** Height of the gradient band in px. */
  height?: number
}

const { top, bottom, height = 96 } = Astro.props
---

<div class="divider-wrap">
  <div
    class="divider"
    style={`height:${height}px;background:linear-gradient(${top} 0 50%, ${bottom} 50% 100%)`}>
    <div class="d-stripes chroma-stripes"></div>
  </div>
  <slot />
</div>

<style>
  .divider-wrap {
    position: relative;
  }
  .divider {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .d-stripes {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 14px;
    transform: translateY(-50%);
  }
</style>
