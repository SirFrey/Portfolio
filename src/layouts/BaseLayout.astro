---
import '@fortawesome/fontawesome-svg-core/styles.css'
import '@fontsource-variable/montserrat'
import '@fontsource-variable/unbounded'
import '@styles/normalize.css'
import '@styles/index.css'
import Analytics from '@vercel/analytics/astro'
import { dicts, type Lang } from '../i18n/loader'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const SITE = 'https://sirfrey.com'
const name = 'Moises Castellanos'
const role = lang === 'es' ? 'Desarrollador frontend' : 'Frontend developer'
// The share text is the hero's intro line, so the two can't drift apart.
const meta = {
  title: `${name} | ${role}`,
  description: dicts[lang].mainsection.intro,
  // New filenames on purpose: LinkedIn and WhatsApp cache previews by URL.
  ogImage: `${SITE}/images/og-${lang}.png`,
  ogImageAlt: `${name}, ${role.toLowerCase()}`,
  url: `${SITE}/${lang}/`,
}
---

<!doctype html>
<html lang={lang} style="background:#14203a;color-scheme:dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#14203a" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style is:inline>
      html, body { background: #14203a; margin: 0; color: #eef2f8; }
      .scene-root { visibility: hidden !important; }
      .scene-root.r3f-ready { visibility: visible !important; opacity: 0.7; }
    </style>
    <meta name="keywords" content="portfolio, web, developer, frontend, backend, fullstack" />
    <meta name="author" content="Moises Castellanos" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:locale" content={lang === 'es' ? 'es_VE' : 'en_US'} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.url} />
    <meta property="og:image" content={meta.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />

    {
      lang === 'es' && (
        <meta
          name="google-site-verification"
          content="GxY_RzqX7Z-W9_U_2_9jW6Q-VjvC-jWn-E_0Q_X_Ws"
        />
      )
    }
    <Analytics />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/reveal.ts'
    </script>
  </body>
</html>
